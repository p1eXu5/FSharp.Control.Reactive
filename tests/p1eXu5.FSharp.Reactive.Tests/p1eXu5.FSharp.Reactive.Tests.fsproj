<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="FsCheck" Version="3.3.3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageReference Include="Microsoft.Reactive.Testing" Version="7.0.0-preview.15" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Runners" Version="3.12.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="Unquote" Version="7.0.1" />
    </ItemGroup>
    
    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" Condition="Exists('AssemblyInfo.fs')" />
        <Compile Include="GenTestNotification.fs" />
        <Compile Include="Marbles.fs" />
        <Compile Include="SchedulerSpecs.fs" />
        <Compile Include="ObservableSpecs.fs" />
        <Compile Include="SubjectSpecs.fs" />
        <Compile Include="DisposableSpecs.fs" />
        <Compile Include="EmitsSpecs.fs" />
        <Compile Include="MarbleSpecs.fs" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\src\p1eXu5.FSharp.Reactive.Testing\p1eXu5.FSharp.Reactive.Testing.fsproj" />
      <ProjectReference Include="..\..\src\p1eXu5.FSharp.Reactive\p1eXu5.FSharp.Reactive.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.300" />
    </ItemGroup>
</Project>
